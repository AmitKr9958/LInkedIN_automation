# Runtime
DRY_RUN=true
HEADLESS=false
BROWSER_PROFILE_DIR=.browser-profile
LOG_LEVEL=INFO
APPROVAL_REQUIRED=true

# Optional Telegram completion notifications
# Create a bot with @BotFather and obtain your private chat ID.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional AI provider for dashboard drafting/analysis
# OpenRouter is the default compatible provider; 9router can be used by
# setting LLM_PROVIDER=9router and LLM_BASE_URL to your local OpenAI-compatible endpoint.
LLM_PROVIDER=none
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/auto
OPENROUTER_API_KEY=
NINE_ROUTER_API_KEY=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_HTTP_REFERER=http://127.0.0.1:8765
LLM_APP_NAME=LinkedIn Agent Control Center
OPENAI_API_KEY=

# LinkedIn
LINKEDIN_BASE_URL=https://www.linkedin.com
